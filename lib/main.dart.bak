import 'package:flutter/material.dart';

void main() {
  runApp(const BloomApp());
}

// ============================================================
// BLOOM — PREMIUM SOCIAL EXPERIENCE
// ============================================================

const Color premiumBlue = Color(0xFF1557D6);
const Color lightBlue = Color(0xFFEAF3FF);
const Color navy = Color(0xFF14213D);
const Color softText = Color(0xFF718096);
const Color pageBg = Color(0xFFF7F9FC);

class BloomApp extends StatelessWidget {
  const BloomApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'BLOOM',
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: pageBg,
        colorScheme: ColorScheme.fromSeed(
          seedColor: premiumBlue,
          brightness: Brightness.light,
        ),
      ),
      home: const BloomShell(),
    );
  }
}

// ============================================================
// SHELL
// ============================================================

class BloomShell extends StatefulWidget {
  const BloomShell({super.key});

  @override
  State<BloomShell> createState() => _BloomShellState();
}

class _BloomShellState extends State<BloomShell> {
  int index = 0;

  final pages = const [
    BloomHomePage(),
    CirclePage(),
    SizedBox(),
    NotificationsPage(),
    ProfilePage(),
  ];

  void select(int value) {
    if (value == 2) {
      showModalBottomSheet(
        context: context,
        backgroundColor: Colors.white,
        showDragHandle: true,
        builder: (_) => const CreateBloomSheet(),
      );
      return;
    }

    setState(() => index = value);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: pages[index],
      bottomNavigationBar: NavigationBar(
        backgroundColor: Colors.white,
        surfaceTintColor: Colors.white,
        selectedIndex: index,
        onDestinationSelected: select,
        indicatorColor: lightBlue,
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(
              Icons.home_rounded,
              color: premiumBlue,
            ),
            label: 'Home',
          ),
          NavigationDestination(
            icon: Icon(Icons.people_outline_rounded),
            selectedIcon: Icon(
              Icons.people_rounded,
              color: premiumBlue,
            ),
            label: 'Circle',
          ),
          NavigationDestination(
            icon: Icon(
              Icons.add_rounded,
              color: premiumBlue,
            ),
            selectedIcon: Icon(
              Icons.add_rounded,
              color: premiumBlue,
            ),
            label: 'Bloom',
          ),
          NavigationDestination(
            icon: Icon(Icons.notifications_none_rounded),
            selectedIcon: Icon(
              Icons.notifications_rounded,
              color: premiumBlue,
            ),
            label: 'Alerts',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline_rounded),
            selectedIcon: Icon(
              Icons.person_rounded,
              color: premiumBlue,
            ),
            label: 'Profile',
          ),
        ],
      ),
    );
  }
}

// ============================================================
// HOME
// ============================================================

class BloomHomePage extends StatelessWidget {
  const BloomHomePage({super.key});

  @override
  Widget build(BuildContext context) {
    return CustomScrollView(
      slivers: [
        SliverAppBar(
          pinned: true,
          backgroundColor: Colors.white,
          surfaceTintColor: Colors.white,
          elevation: 0,
          title: const Text(
            'BLOOM',
            style: TextStyle(
              color: premiumBlue,
              fontSize: 25,
              fontWeight: FontWeight.w900,
              letterSpacing: 2,
            ),
          ),
          actions: [
            IconButton(
              onPressed: () {},
              icon: const Icon(
                Icons.search_rounded,
                color: navy,
              ),
            ),
            IconButton(
              onPressed: () {},
              icon: const Icon(
                Icons.mail_outline_rounded,
                color: navy,
              ),
            ),
            const SizedBox(width: 4),
          ],
        ),
        SliverPadding(
          padding: const EdgeInsets.fromLTRB(16, 10, 16, 30),
          sliver: SliverList(
            delegate: SliverChildListDelegate([
              const _Greeting(),
              const SizedBox(height: 18),
              const _CreateBloomCard(),
              const SizedBox(height: 24),
              const _SectionTitle(
                title: 'Moments',
                subtitle: 'Cerita dari circle kamu',
              ),
              const SizedBox(height: 12),
              const _StoryRow(),
              const SizedBox(height: 24),
              _PostCard(
                name: 'Ayie',
                time: '12 menit lalu',
                avatarLetter: 'A',
                text:
                    'Hari ini terasa sederhana, tapi justru hal-hal kecil seperti ini yang ingin aku simpan. ✨',
                mood: 'Feeling peaceful',
                location: 'Bandung',
                reactionCount: 28,
              ),
              const SizedBox(height: 16),
              _PostCard(
                name: 'BLOOM',
                time: '1 jam lalu',
                avatarLetter: 'B',
                text:
                    'Selamat datang di BLOOM — tempat menyimpan momen yang benar-benar berarti.',
                mood: 'Feeling grateful',
                location: 'BLOOM',
                reactionCount: 64,
              ),
              const SizedBox(height: 24),
              const _ActivityCard(),
            ]),
          ),
        ),
      ],
    );
  }
}

// ============================================================
// GREETING
// ============================================================

class _Greeting extends StatelessWidget {
  const _Greeting();

  @override
  Widget build(BuildContext context) {
    return Row(
      children: [
        const Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                'Good evening',
                style: TextStyle(
                  color: softText,
                  fontSize: 14,
                ),
              ),
              SizedBox(height: 3),
              Text(
                'Apa kabarmu hari ini?',
                style: TextStyle(
                  color: navy,
                  fontSize: 22,
                  fontWeight: FontWeight.w800,
                ),
              ),
            ],
          ),
        ),
        Container(
          width: 48,
          height: 48,
          decoration: const BoxDecoration(
            shape: BoxShape.circle,
            color: premiumBlue,
          ),
          child: const Center(
            child: Text(
              'A',
              style: TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.bold,
                fontSize: 18,
              ),
            ),
          ),
        ),
      ],
    );
  }
}

