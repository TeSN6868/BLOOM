class _BloomDailyRhythmState extends State<BloomDailyRhythm> {
  late DateTime _now;
  late Timer _timer;

  @override
  void initState() {
    super.initState();
    _now = DateTime.now();

    _timer = Timer.periodic(const Duration(minutes: 1), (_) {
      if (!mounted) return;
      setState(() => _now = DateTime.now());
    });
  }

  @override
  void dispose() {
    _timer.cancel();
    super.dispose();
  }

  Map<String, dynamic> get _rhythm {
    final minutes = _now.hour * 60 + _now.minute;

    if (minutes >= 300 && minutes < 420) {
      return {
        'title': 'Awal hari',
