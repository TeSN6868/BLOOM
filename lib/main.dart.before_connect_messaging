              ? name
              : (username.isNotEmpty ? username : 'BLOOM');

          return GestureDetector(
            onTap: () {
              Navigator.of(context).push(
                MaterialPageRoute(
                  builder: (_) => _BloomStoryViewer(
                    displayName: displayName,
                    mediaUrl: mediaUrl,
                    mediaType: mediaType,
                    text: text,
