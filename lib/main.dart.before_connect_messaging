    required this.name,
    this.radius = 27,
  });

  @override
  Widget build(BuildContext context) {
    final raw = photoUrl.trim();

    String? resolved;

    if (raw.isNotEmpty) {
      resolved = raw.startsWith('http://') ||
              raw.startsWith('https://')
          ? raw
          : raw.startsWith('/')
              ? '${BloomApi.baseUrl}$raw'
              : '${BloomApi.baseUrl}/$raw';
    }

    return CircleAvatar(
      radius: radius,
      backgroundColor: premiumBlue,
      backgroundImage:
          resolved == null ? null : NetworkImage(resolved),
      child: resolved == null
          ? Text(
              name.isEmpty ? 'B' : name[0].toUpperCase(),
              style: TextStyle(
                color: Colors.white,
                fontSize: radius * .7,
                fontWeight: FontWeight.w900,
              ),
            )
          : null,
    );
  }
}


