  @override
  void initState() {
    super.initState();

    _messaging = const BloomMessagingService(
      baseUrl: BloomApi.baseUrl,
    );
  }

  @override
  void dispose() {
    _userIdController.dispose();
    super.dispose();
  }

  Future<void> _start() async {
    if (_opening) return;

    final otherUserId = _userIdController.text.trim();

    if (otherUserId.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Masukkan ID pengguna BLOOM.'),
        ),
      );
      return;
    }

    try {
      final userId = await BloomApi.getUserId();

      if (userId == null || userId.trim().isEmpty) {
        throw Exception('User belum login');
      }

      if (userId == otherUserId) {
        throw Exception('Tidak bisa mengirim pesan ke diri sendiri');
      }

      setState(() {
        _opening = true;
      });

      final conversation = await _messaging.createConversation(
        userId: userId,
        otherUserId: otherUserId,
      );

      if (!mounted) return;

      await Navigator.of(context).push(
        MaterialPageRoute(
          builder: (_) => BloomChatPage(
            userId: userId,
            conversation: conversation,
          ),
        ),
      );

      if (mounted) {
        setState(() {
          _opening = false;
        });
      }
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _opening = false;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            e.toString().replaceFirst('Exception: ', ''),
