class _BloomMessagesPageState extends State<BloomMessagesPage> {
  late final BloomMessagingService _messaging;

  List<BloomConversation> _conversations = const [];
  bool _loading = true;
  String? _error;
  String? _userId;

  @override
  void initState() {
    super.initState();

    _messaging = const BloomMessagingService(
      baseUrl: BloomApi.baseUrl,
    );

    _load();
  }

  Future<void> _load() async {
    setState(() {
      _loading = true;
      _error = null;
    });

    try {
      final userId = await BloomApi.getUserId();

      if (userId == null || userId.trim().isEmpty) {
        throw Exception('User belum login');
      }

      final conversations = await _messaging.getConversations(
        userId: userId,
      );

      if (!mounted) return;

      setState(() {
        _userId = userId;
        _conversations = conversations;
        _loading = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = e.toString().replaceFirst('Exception: ', '');
      });
    }
  }

  Future<void> _openConversation(
    BloomConversation conversation,
  ) async {
    final userId = _userId;

    if (userId == null || userId.isEmpty) return;

    await Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => BloomChatPage(
          userId: userId,
          conversation: conversation,
        ),
      ),
    );

    if (mounted) {
      _load();
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: pageBg,
      appBar: AppBar(
        backgroundColor: premiumBlue,
        foregroundColor: Colors.white,
        elevation: 0,
        title: const Text(
          'Pesan',
          style: TextStyle(
            fontWeight: FontWeight.w900,
          ),
        ),
        actions: [
          IconButton(
            onPressed: () {
              Navigator.of(context).push(
                MaterialPageRoute(
                  builder: (_) => const BloomStartChatPage(),
                ),
              );
            },
            tooltip: 'Pesan Baru',
            icon: const Icon(Icons.edit_rounded),
          ),
          IconButton(
            onPressed: _loading ? null : _load,
            icon: const Icon(Icons.refresh_rounded),
          ),
        ],
      ),
      body: _buildBody(),
    );
  }

  Widget _buildBody() {
    if (_loading) {
      return const Center(
        child: CircularProgressIndicator(
          color: premiumBlue,
        ),
      );
    }

    if (_error != null) {
      return Center(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              const Icon(
                Icons.chat_bubble_outline_rounded,
                color: premiumBlue,
                size: 52,
              ),
              const SizedBox(height: 14),
              Text(
                _error!,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  color: navy,
                  fontWeight: FontWeight.w700,
                ),
              ),
              const SizedBox(height: 18),
              ElevatedButton.icon(
                onPressed: _load,
                icon: const Icon(Icons.refresh_rounded),
                label: const Text('Coba Lagi'),
              ),
            ],
          ),
        ),
      );
    }

    if (_conversations.isEmpty) {
      return RefreshIndicator(
        color: premiumBlue,
        onRefresh: _load,
        child: ListView(
          physics: const AlwaysScrollableScrollPhysics(),
          children: const [
            SizedBox(height: 150),
            Icon(
              Icons.forum_outlined,
              color: premiumBlue,
              size: 58,
            ),
            SizedBox(height: 16),
            Center(
              child: Text(
                'Belum ada percakapan',
