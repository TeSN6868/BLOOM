    final confirmed = await showDialog<bool>(
      context: context,
      builder: (_) => AlertDialog(
        backgroundColor: Colors.white,
        title: const Text(
          'Hapus status?',
          style: TextStyle(color: navy, fontWeight: FontWeight.w900),
